rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // The owner is the uid in settings/owner (written by the app on the owner's first login). Until that
    // document exists the original admin account (admin@shahm-debts.app) is the owner, so the owner can then
    // switch to a real email. Deleting settings/owner from the Firebase console hands ownership back to admin@.
    function ownerDoc() { return /databases/$(database)/documents/settings/owner; }
    function isOwner() {
      return signedIn() && (exists(ownerDoc())
        ? get(ownerDoc()).data.uid == request.auth.uid
        : request.auth.token.email == 'admin@shahm-debts.app');
    }
    function hasProf() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function prof() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return isOwner() || (hasProf() && prof().status == 'active'); }
    function writer() { return isOwner() || (active() && prof().role == 'editor'); }
    // An editor the owner trusted with the items (users/{uid}.items, set only by the owner) manages items and prices.
    function itemsMgr() { return isOwner() || (active() && prof().role == 'editor' && prof().get('items', false) == true); }

    // Shape checks on what the apps write. The owner is exempt (restoring a backup writes old records as they are);
    // everyone else can only write records the apps themselves would write.
    function d() { return request.resource.data; }
    function str(v, max) { return v is string && v.size() <= max; }
    function amountOk(v) { return v is number && v > 0 && v < 10000000000; }
    function nameOk(v) { return str(v, 100) && v.size() > 0; }
    function imageOk(v) { return v is string && v.size() < 1048000 && v.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'); }
    // Written by this person (their profile name, as the apps put it), not dated in the future.
    function selfSigned(x) { return (x.by == prof().get('name', x.by) || prof().get('name', '') == '') && x.at is number && x.at < request.time.toMillis() + 86400000; }

    match /customers/{id} {
      allow read: if active();
      allow create, update: if writer() && (isOwner() || (d().id == id && nameOk(d().name)));
      allow delete: if writer();
    }
    match /txns/{id} {
      allow read: if active();
      allow create, update: if writer() && (isOwner() || (d().id == id && d().customerId is string
        && d().type in ['debt', 'pay'] && amountOk(d().amount)));
      allow delete: if writer();
    }
    // Invoice photos (one compressed JPEG per document), linked from txns.photos.
    match /photos/{id} {
      allow read: if active();
      allow create, update: if writer() && (isOwner() || (d().id == id && imageOk(d().data)));
      allow delete: if writer();
    }
    match /activity/{id} {
      allow read: if active();
      allow create: if isOwner() || (d().id == id && selfSigned(d()) && (writer() || (active() && d().kind == 'remind')));
      allow update, delete: if isOwner();
    }
    match /settings/{id}  {
      allow read: if active();
      allow write: if isOwner() && (id != 'owner' || (request.resource != null && request.resource.data.uid is string));
    }
    // Readable only once these rules are published; the app checks it before letting the owner change email.
    match /meta/{id} {
      allow get: if signedIn() && (id == 'rules-v2' || id == 'trial');
      // trial: how many days a newly registered shop opens by itself (0 = waits for this owner, as before).
      allow write: if isOwner() && id == 'trial' && d().keys().hasOnly(['days', 'at']) && d().days is int && d().days >= 0 && d().days <= 90;
    }
    // Cashier (web/pos/): the owner (and an editor given «يدير المواد») manages items and prices; editors sell;
    // only the owner cancels a sale. A sale lowers the stock of what it sold, so editors may change the stock field.
    match /products/{id}  {
      allow read: if active();
      allow write: if itemsMgr();
      allow update: if writer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) && d().stock is number;
    }
    // One small photo per item (id = the item's id): everyone signed in sees them, whoever manages the items changes them.
    match /itemPhotos/{id} {
      allow read: if active();
      allow create, update: if itemsMgr() && (isOwner() || imageOk(d().data));
      allow delete: if itemsMgr();
    }
    // An editor's sale with a discount needs a discount the owner approved for exactly this invoice total,
    // and the same write marks that approval used, so it cannot be spent twice.
    function apPath(aid) { return /databases/$(database)/documents/approvals/$(aid); }
    function discountOk(d) {
      return !('discount' in d) || d.discount == 0 || isOwner() || (('approvalId' in d) && d.approvalId is string
        && exists(apPath(d.approvalId))
        && get(apPath(d.approvalId)).data.status == 'approved'
        && get(apPath(d.approvalId)).data.byId == request.auth.uid
        && get(apPath(d.approvalId)).data.amount >= d.discount
        && get(apPath(d.approvalId)).data.subtotal == d.subtotal
        && getAfter(apPath(d.approvalId)).data.status == 'used');
    }
    match /sales/{id} {
      allow read: if active();
      allow create: if writer() && discountOk(request.resource.data) && (isOwner() || (d().id == id && d().status == 'done'
        && d().date is string && d().date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d().total is number && d().total >= 0));
      allow update, delete: if isOwner();
    }
    // Discount requests: an editor asks, the owner approves or refuses; the editor can only withdraw a pending
    // request or mark an approved one used by a sale.
    match /approvals/{id} {
      allow read: if active();
      allow create: if writer() && request.resource.data.byId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isOwner() || (writer() && resource.data.byId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'saleId', 'usedAt'])
        && ((resource.data.status == 'pending' && request.resource.data.status == 'cancelled')
          || (resource.data.status == 'approved' && request.resource.data.status == 'used')));
      allow delete: if isOwner();
    }
    // Shifts: whoever sells opens and closes them (the next cashier may close someone else's shift, under their own
    // name); how it was opened never changes, and a closed shift is final (only the owner can delete one).
    match /shifts/{id} {
      allow read: if active();
      allow create: if writer() && d().status == 'open' && (isOwner() || d().openedById == request.auth.uid);
      allow update: if writer() && resource.data.status == 'open' && (isOwner() || (
        d().diff(resource.data).affectedKeys().hasOnly(['noSale', 'status', 'closedAt', 'closedBy', 'closedById', 'counted', 'expected',
          'diff', 'note', 'z', 'usdExpected', 'usdCounted', 'usdDiff'])
        && (d().status == 'open' || (d().status == 'closed' && d().closedById == request.auth.uid))));
      allow delete: if isOwner();
    }
    // Stocktakes: whoever manages the items saves a count of the shelves; everyone who can read the cashier can see the record.
    match /stocktakes/{id} {
      allow read: if active();
      allow create: if itemsMgr();
      allow update, delete: if isOwner();
    }
    // Deliveries received (استلام المواد): the items, quantities and purchase prices, with the supplier.
    match /receipts/{id} {
      allow read: if active();
      allow create: if itemsMgr();
      allow update, delete: if isOwner();
    }
    // Price changes: whoever changes a price records it under their own account; the record is never edited.
    match /prices/{id} {
      allow read: if active();
      allow create: if writer() && request.resource.data.byId == request.auth.uid;
      allow delete: if isOwner();
    }
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      // Signing up here: not an account that belongs to another shop.
      allow create: if isOwner() || (signedIn() && request.auth.uid == uid && !exists(memberPath(uid)) && signUpOk(uid));
      allow update, delete: if isOwner();
    }
    // Signing up: a pending viewer with only the fields the sign-up form writes.
    function signUpOk(uid) {
      return d().keys().hasOnly(['id', 'name', 'username', 'role', 'status', 'createdAt', 'phone'])
        && d().id == uid && nameOk(d().name) && str(d().username, 40) && str(d().get('phone', ''), 30)
        && d().status == 'pending' && d().role == 'viewer';
    }

    // ---------- Other shops (one app, many shops) ----------
    // Each shop that signs up in the app gets its own notebook under shops/{s}, where s is its owner's uid. It opens only
    // once this app's owner (isOwner) sets its status to 'active'; 'disabled' or a passed end date (until) closes it again
    // without deleting anything.
    // Nobody in another shop can read or write this shop's data at the root, and this owner has no access to theirs.
    // memberOf/{uid} only says which shop an account opens: each account writes its own, and it grants nothing by itself.
    function memberPath(uid) { return /databases/$(database)/documents/memberOf/$(uid); }
    function shopPath(s) { return /databases/$(database)/documents/shops/$(s); }
    // An active shop with an end date (until, in ms, set by this owner when it pays for a month, 6 months...) closes at
    // that moment by itself; no until = no end. The data stays, and renewing (a later until) opens it again.
    function shopOn(s) { return exists(shopPath(s)) && get(shopPath(s)).data.status == 'active'
      && (get(shopPath(s)).data.get('until', null) == null || get(shopPath(s)).data.until > request.time.toMillis()); }
    function trialDays() { return exists(/databases/$(database)/documents/meta/trial) ? get(/databases/$(database)/documents/meta/trial).data.days : 0; }
    function trialOk(until) { return trialDays() > 0 && until is number && until > request.time.toMillis()
      && until <= request.time.toMillis() + trialDays() * 86400000 + 3600000; }
    function sOwner(s) { return signedIn() && request.auth.uid == s; }
    function sProfPath(s) { return /databases/$(database)/documents/shops/$(s)/users/$(request.auth.uid); }
    function sProf(s) { return get(sProfPath(s)).data; }
    function sMember(s) { return signedIn() && exists(sProfPath(s)) && sProf(s).status == 'active'; }
    function sReader(s) { return shopOn(s) && (sOwner(s) || sMember(s)); }
    function sWriter(s) { return shopOn(s) && (sOwner(s) || (sMember(s) && sProf(s).role == 'editor')); }
    function sBoss(s) { return shopOn(s) && sOwner(s); }
    function sSigned(s, x) { return (x.by == sProf(s).get('name', x.by) || sProf(s).get('name', '') == '') && x.at is number && x.at < request.time.toMillis() + 86400000; }

    match /memberOf/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && d().keys().hasOnly(['shop', 'at'])
        && str(d().shop, 128) && d().shop.size() > 0 && d().at is number;
    }
    match /shops/{s} {
      allow get: if isOwner() || sOwner(s) || (signedIn() && exists(sProfPath(s)));
      allow list: if isOwner();
      // A new shop waits for this owner (pending), or opens by itself for the free trial this owner set in meta/trial,
      // never longer than that: its end (until) is checked against the server clock.
      allow create: if sOwner(s) && d().keys().hasOnly(['id', 'owner', 'name', 'ownerName', 'phone', 'username', 'status', 'createdAt', 'trial', 'until'])
        && d().id == s && d().owner == s && nameOk(d().name) && nameOk(d().ownerName) && str(d().phone, 30)
        && str(d().username, 40) && d().createdAt is number
        && ((d().status == 'pending' && !('trial' in d()) && !('until' in d())) || (d().status == 'active' && d().trial == true && trialOk(d().until)));
      allow update: if isOwner() || (sOwner(s) && d().diff(resource.data).affectedKeys().hasOnly(['name', 'ownerName', 'phone'])
        && nameOk(d().name) && nameOk(d().ownerName) && str(d().phone, 30));
      allow delete: if isOwner();

      match /customers/{id} {
        allow read: if sReader(s);
        allow create, update: if sWriter(s) && (sOwner(s) || (d().id == id && nameOk(d().name)));
        allow delete: if sWriter(s);
      }
      match /txns/{id} {
        allow read: if sReader(s);
        allow create, update: if sWriter(s) && (sOwner(s) || (d().id == id && d().customerId is string
          && d().type in ['debt', 'pay'] && amountOk(d().amount)));
        allow delete: if sWriter(s);
      }
      match /photos/{id} {
        allow read: if sReader(s);
        allow create, update: if sWriter(s) && (sOwner(s) || (d().id == id && imageOk(d().data)));
        allow delete: if sWriter(s);
      }
      match /activity/{id} {
        allow read: if sReader(s);
        allow create: if sBoss(s) || (sReader(s) && d().id == id && sSigned(s, d()) && (sWriter(s) || d().kind == 'remind'));
        allow update, delete: if sBoss(s);
      }
      match /settings/{id} {
        allow read: if sReader(s);
        allow write: if sBoss(s) && id == 'main';
      }
      // Its workers: the shop's owner makes their accounts (or approves one that asks), as at the root.
      match /users/{uid} {
        allow read: if sBoss(s) || (signedIn() && request.auth.uid == uid);
        allow create: if sBoss(s) || (signedIn() && request.auth.uid == uid && signUpOk(uid));
        allow update, delete: if sBoss(s);
      }
    }
  }
}
